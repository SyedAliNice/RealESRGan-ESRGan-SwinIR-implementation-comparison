{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DetailFrame model catalog version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tested_at", "torch_version", "checkpoint_sha256"],
      "properties": {
        "status": {
          "const": "passed"
        },
        "tested_at": {
          "type": "string",
          "format": "date"
        },
        "torch_version": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "architecture",
        "scale",
        "weight_file",
        "weight_url",
        "sha256",
        "license",
        "provenance_url",
        "devices",
        "enabled",
        "validation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "integer",
          "minimum": 2
        },
        "weight_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "weight_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "provenance_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "devices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["cpu", "cuda"]
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "validation": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/validation_record"
          },
          "properties": {
            "cpu": {
              "$ref": "#/$defs/validation_record"
            },
            "cuda": {
              "$ref": "#/$defs/validation_record"
            }
          }
        },
        "expected_state_dict": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": ["enabled"]
          },
          "then": {
            "required": ["expected_state_dict"],
            "properties": {
              "devices": {
                "minItems": 1,
                "contains": {
                  "const": "cpu"
                }
              },
              "validation": {
                "required": ["cpu"]
              }
            }
          }
        }
      ]
    }
  }
}
