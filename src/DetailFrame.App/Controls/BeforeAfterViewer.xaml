<UserControl
    x:Class="DetailFrame.App.Controls.BeforeAfterViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ZoomOutButton"
                    Content="&#xE71F;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    AutomationProperties.Name="Zoom out"
                    ToolTipService.ToolTip="Zoom out (minus)"
                    Click="ZoomOut_Click" />
            <Button x:Name="ZoomInButton"
                    Content="&#xE8A3;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    AutomationProperties.Name="Zoom in"
                    ToolTipService.ToolTip="Zoom in (plus)"
                    Click="ZoomIn_Click" />
            <Button x:Name="FitButton"
                    Content="Fit to view"
                    ToolTipService.ToolTip="Fit to view (0)"
                    Click="Fit_Click" />
            <TextBlock x:Name="ZoomText"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <Grid x:Name="Viewport"
              Grid.Row="1"
              MinHeight="240"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              IsTabStop="True"
              UseSystemFocusVisuals="True"
              AutomationProperties.Name="Before and after image comparison"
              AutomationProperties.HelpText="Arrow keys move the divider, plus and minus zoom, zero fits to view."
              SizeChanged="Viewport_SizeChanged"
              PointerWheelChanged="Viewport_PointerWheelChanged"
              KeyDown="Viewport_KeyDown"
              PointerPressed="Viewport_PointerPressed"
              PointerMoved="Viewport_PointerMoved"
              PointerReleased="Viewport_PointerReleased"
              PointerCanceled="Viewport_PointerReleased"
              PointerCaptureLost="Viewport_PointerReleased">
            <Grid x:Name="OriginalLayer">
                <Image x:Name="OriginalImage"
                       Stretch="Uniform"
                       RenderTransformOrigin="0,0"
                       AutomationProperties.AccessibilityView="Raw"
                       AutomationProperties.Name="Original image" />
            </Grid>
            <Grid x:Name="ResultLayer">
                <Image x:Name="ResultImage"
                       Stretch="Uniform"
                       RenderTransformOrigin="0,0"
                       AutomationProperties.AccessibilityView="Raw"
                       AutomationProperties.Name="Enhanced image" />
            </Grid>
            <Rectangle x:Name="DividerLine"
                       Width="3"
                       HorizontalAlignment="Left"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}"
                       IsHitTestVisible="False" />
            <Border x:Name="DividerHandle"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    IsHitTestVisible="False">
                <FontIcon Glyph="&#xE76F;" Foreground="White" FontSize="14" />
            </Border>
            <Border Margin="8" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#99000000" CornerRadius="4" IsHitTestVisible="False">
                <TextBlock Text="Original" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
            <Border Margin="8" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#99000000" CornerRadius="4" IsHitTestVisible="False">
                <TextBlock Text="Enhanced" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
        </Grid>

        <Slider x:Name="DividerSlider"
                Grid.Row="2"
                Minimum="0"
                Maximum="100"
                StepFrequency="1"
                SmallChange="1"
                LargeChange="10"
                Value="50"
                AutomationProperties.Name="Comparison divider"
                ValueChanged="DividerSlider_ValueChanged" />
    </Grid>
</UserControl>
