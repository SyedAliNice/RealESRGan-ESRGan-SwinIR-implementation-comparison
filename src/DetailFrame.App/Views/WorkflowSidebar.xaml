<UserControl
    x:Class="DetailFrame.App.Views.WorkflowSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Spacing="4" Padding="8">
        <TextBlock Text="Workflow"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="12,8,0,8"
                   AutomationProperties.HeadingLevel="Level2" />
        <ListView x:Name="StageList"
                  SelectionMode="Single"
                  IsItemClickEnabled="False"
                  TabNavigation="Once"
                  AutomationProperties.Name="Workflow stages"
                  SelectionChanged="StageList_SelectionChanged" />
    </StackPanel>
</UserControl>
